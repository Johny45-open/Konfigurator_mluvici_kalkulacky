{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Johny45-open/Mluvici_kalkulacka/statistics_schema_v1.json",
  "title": "Mluvici kalkulacka statistics contract v1",
  "description": "Kanonicke schema pro prenositelny soubor statistickych sad. Verze 1. Oddeleno od config kontraktu.",
  "type": "object",
  "required": ["schemaVersion", "sets", "folders", "currentIndex"],
  "properties": {
    "schemaVersion": {"type":"integer","const":1,"description":"Verze schema statistik."},
    "createdAt": {"type":"string","format":"date-time"},
    "generator": {"type":"string"},
    "statisticsCompatibility": {"type":"object","required":["minVersion"],"properties":{"minVersion":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+.*$"},"maxVersion":{"type":["string","null"],"pattern":"^\\d+\\.\\d+\\.\\d+.*$"}}},
    "currentIndex": {"type":"integer","minimum":0},
    "folders": {"type":"array","items":{"$ref":"#/$defs/folder"}},
    "sets": {"type":"array","items":{"$ref":"#/$defs/set"}}
  },
  "$defs": {
    "folder": {"type":"object","required":["id","name"],"properties":{
      "id":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},
      "colorIndex":{"type":"integer","minimum":0,"maximum":7},"iconName":{"type":"string","enum":["dataset","school","work","home","lab","chart","folder","star"]},
      "sortOrder":{"type":"integer"},"createdAt":{"type":"string","format":"date-time"}
    }},
    "set": {"type":"object","required":["id","name","fieldNames","records"],"properties":{
      "id":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},
      "fieldNames":{"type":"array","minItems":1,"maxItems":10,"items":{"type":"string","minLength":1}},
      "fieldUnits":{"type":"array","minItems":1,"maxItems":10,"items":{"type":["string","null"]}},
      "records":{"type":"array","items":{"type":"object","required":["values"],"properties":{"values":{"type":"array","items":{"type":"number"}}}}},
      "folderId":{"type":["string","null"]},"colorIndex":{"type":"integer","minimum":0,"maximum":7},"iconName":{"type":"string","enum":["dataset","school","work","home","lab","chart","folder","star"]},
      "pinned":{"type":"boolean"},"archived":{"type":"boolean"},
      "createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"lastUsedAt":{"type":"string","format":"date-time"}
    }}
  }
}
